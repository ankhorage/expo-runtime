{
  "name": "@ankhorage/expo-runtime",
  "type": "module",
  "version": "0.0.4",
  "description": "Declarative runtime integration for Expo apps: maps app capabilities to permissions, packages, config plugins, providers, and adapters",
  "homepage": "https://github.com/ankhorage/expo-runtime#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/expo-runtime/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/expo-runtime.git"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "runtime"
  ],
  "dependencies": {
    "@ankhorage/contracts": "^1.18.2",
    "@ankhorage/permissions": "^0.2.0",
    "@ankhorage/zora": "^2.8.0"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./planning": {
      "react-native": "./src/planning.ts",
      "browser": "./src/planning.ts",
      "types": "./src/planning.ts",
      "import": "./dist/planning.js",
      "default": "./dist/planning.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "docs": "paradox",
    "knip": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.0.6",
    "@ankhorage/paradox": "^0.1.10",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13"
}
