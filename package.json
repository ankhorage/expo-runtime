{
  "name": "@ankhorage/expo-runtime",
  "type": "module",
  "version": "3.0.13",
  "description": "Declarative runtime integration for Expo apps: maps app capabilities to permissions, packages, config plugins, providers, and adapters",
  "homepage": "https://github.com/ankhorage/expo-runtime#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/expo-runtime/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/expo-runtime.git"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "runtime"
  ],
  "dependencies": {
    "@ankhorage/contracts": "^8.0.0"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./action-bridge": {
      "react-native": "./src/actionBridge.ts",
      "browser": "./src/actionBridge.ts",
      "types": "./src/actionBridge.ts",
      "import": "./dist/actionBridge.js",
      "default": "./dist/actionBridge.js"
    },
    "./planning": {
      "react-native": "./src/planning.ts",
      "browser": "./src/planning.ts",
      "types": "./src/planning.ts",
      "import": "./dist/planning.js",
      "default": "./dist/planning.js"
    },
    "./platform": {
      "react-native": "./src/platform.ts",
      "browser": "./src/platform.ts",
      "types": "./src/platform.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./icon-fonts": {
      "browser": "./src/ExpoZoraIconFontProvider.web.tsx",
      "react-native": "./src/ExpoZoraIconFontProvider.tsx",
      "types": "./src/ExpoZoraIconFontProvider.tsx",
      "node": "./src/ExpoZoraIconFontProvider.web.tsx",
      "import": "./dist/ExpoZoraIconFontProvider.js",
      "default": "./dist/ExpoZoraIconFontProvider.js"
    },
    "./oauth-browser": {
      "react-native": "./src/oauthBrowserTransport.ts",
      "browser": "./src/oauthBrowserTransport.ts",
      "types": "./src/oauthBrowserTransport.ts",
      "import": "./dist/oauthBrowserTransport.js",
      "default": "./dist/oauthBrowserTransport.js"
    },
    "./oauth-browser-runtime": {
      "react-native": "./src/oauthBrowserRuntime.ts",
      "browser": "./src/oauthBrowserRuntime.ts",
      "types": "./src/oauthBrowserRuntime.ts",
      "import": "./dist/oauthBrowserRuntime.js",
      "default": "./dist/oauthBrowserRuntime.js"
    },
    "./media-picker": {
      "react-native": "./src/mediaPicker/index.ts",
      "browser": "./src/mediaPicker/index.ts",
      "types": "./src/mediaPicker/index.ts",
      "import": "./dist/mediaPicker/index.js",
      "default": "./dist/mediaPicker/index.js"
    },
    "./bundled-media": {
      "react-native": "./src/bundledMedia/index.ts",
      "browser": "./src/bundledMedia/index.ts",
      "types": "./src/bundledMedia/index.ts",
      "import": "./dist/bundledMedia/index.js",
      "default": "./dist/bundledMedia/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "knip:check": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.scripts.json",
    "validate:action-bridge": "bun scripts/actionBridgeAcceptance.ts",
    "validate:expo-platform": "bun scripts/validateExpoPlatform.ts",
    "validate:headless-platform": "bun scripts/headlessPlatformAcceptance.ts",
    "validate:packed-runtime": "bun scripts/packedRuntimeAcceptance.ts",
    "validate:web-barcode": "bun scripts/webBarcodeAcceptance.ts",
    "version-packages": "ankhorage-changeset version"
  },
  "peerDependencies": {
    "@ankhorage/permissions": "^0.2.3",
    "@ankhorage/zora": "^3.0.2",
    "@readium/navigator": "2.8.2",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@zip.js/zip.js": "2.9.0",
    "expo": "57.0.18",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependenciesMeta": {
    "@ankhorage/permissions": {
      "optional": true
    },
    "@ankhorage/zora": {
      "optional": true
    },
    "@readium/navigator": {
      "optional": true
    },
    "@react-native-vector-icons/fontawesome": {
      "optional": true
    },
    "@react-native-vector-icons/fontawesome5": {
      "optional": true
    },
    "@react-native-vector-icons/fontawesome6": {
      "optional": true
    },
    "@react-native-vector-icons/ionicons": {
      "optional": true
    },
    "@react-native-vector-icons/material-design-icons": {
      "optional": true
    },
    "@zip.js/zip.js": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-font": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.8.2",
    "@ankhorage/paradox": "^0.1.24",
    "@ankhorage/permissions": "^0.2.3",
    "@ankhorage/zora": "^3.0.2",
    "@readium/navigator": "2.8.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@zip.js/zip.js": "2.9.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "bwip-js": "^4.11.4",
    "expo": "57.0.18",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
